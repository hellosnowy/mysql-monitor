<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="sql-monitor"
        Arguments=""
        InstallLocation="C:\Program Files\OpenSource\SQL Monitor">
    </Installer>
    <PackageInformation
        PackageName="SQL Monitor"
        PackageDisplayName="SQL Monitor"
        PublisherName="CN=OpenSource"
        PublisherDisplayName="OpenSource"
        Version="1.1.0.0"
        PackageDescription="Multi-database (MySQL, PostgreSQL, SQL Server) DDL and DML Monitor and Diff Tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.opensource.sql-monitor"
                Description="Multi-database (MySQL, PostgreSQL, SQL Server) DDL and DML Monitor and Diff Tool"
                DisplayName="SQL Monitor"
                ExecutableName="sql-monitor"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SQL Monitor</DisplayName>
            <PublisherDisplayName>OpenSource</PublisherDisplayName>
            <Description>Multi-database (MySQL, PostgreSQL, SQL Server) DDL and DML Monitor and Diff Tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="sql-monitor.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
